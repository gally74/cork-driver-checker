{
  "name": "Cork Driver Checker",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && chmod +x start_checker.sh",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Cork Driver Checker",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postStartCommand": "bash start_checker.sh"
}
